public class Interface_image extends JFrame {

    // ── Palette ───────────────────────────────────────────────────────────────
    private static final Color PRIMARY_COLOR  = new Color(25,  118, 210);   // Modern blue
    private static final Color ACCENT_COLOR   = new Color(76,  175,  80);   // Modern green
    private static final Color DANGER_COLOR   = new Color(229,  57,  53);   // Modern red
    private static final Color BG_COLOR       = new Color(248, 249, 250);   // Subtle white
    private static final Color SIDEBAR_COLOR  = new Color(33,   47,  61);   // Dark blue-gray
    private static final Color SIDEBAR_HOVER  = new Color(48,   63,  82);   // Lighter hover
    private static final Color TEXT_LIGHT     = new Color(225, 229, 235);   // Light text
    private static final Color TEXT_DARK      = new Color(33,   47,  61);   // Dark text
    private static final Color CARD_BG        = Color.WHITE;               // Pure white
    private static final Color BORDER_COLOR   = new Color(224, 224, 224);   // Modern border

    // ── Chemin VLC ────────────────────────────────────────────────────────────
    private static final String VLC_PATH = "C:\\Program Files\\VideoLAN\\VLC";

    // ── State ─────────────────────────────────────────────────────────────────
    private double  imageScaleFactor     = 0.5;
    private double  detectionScaleFactor = 0.7;
    private boolean autoDetect           = false;
    private BufferedImage originalImage  = null;

    // ── UI ────────────────────────────────────────────────────────────────────
    private JLabel imageLabel;
    private JLabel imageLabel2;
    private JLabel resultBanner;
    private JLabel statusLabel;
    private JPanel imagesPanel;

    // ══════════════════════════════════════════════════════════════════════════
    public Interface_image() {
        super("Reconnaissance de Panneaux Routiers");
        setupFrame();
        buildUI();
        setVisible(true);
    }

    private void setupFrame() {
        setSize(1400, 850);
        setMinimumSize(new Dimension(1000, 700));
        setDefaultCloseOperation(EXIT_ON_CLOSE);
        setLocationRelativeTo(null);
        setLayout(new BorderLayout());
        getContentPane().setBackground(BG_COLOR);
        setTitle("Road Sign Detection System");
    }

    private void buildUI() {
        add(buildTopToolbar(), BorderLayout.NORTH);
        add(buildContent(),    BorderLayout.CENTER);
        add(buildStatusBar(),  BorderLayout.SOUTH);
    }

    // ══════════════════════════════════════════════════════════════════════════
    //  TOP TOOLBAR WITH GRID BUTTONS
    // ══════════════════════════════════════════════════════════════════════════
    private JPanel buildTopToolbar() {
        JPanel toolbar = new JPanel(new BorderLayout());
        toolbar.setBackground(SIDEBAR_COLOR);
        toolbar.setBorder(BorderFactory.createMatteBorder(0, 0, 1, 0, new Color(15, 35, 70)));
        
        // Title section
        JPanel titleSection = new JPanel(new FlowLayout(FlowLayout.LEFT, 16, 12));
        titleSection.setBackground(SIDEBAR_COLOR);
        JLabel appTitle = new JLabel("🛣️  Reconnaissance de Panneaux Routiers");
        appTitle.setFont(new Font("Segoe UI", Font.BOLD, 15));
        appTitle.setForeground(Color.WHITE);
        titleSection.add(appTitle);
        
        // Button grid (3 columns x 2 rows)
        JPanel buttonGrid = new JPanel(new GridLayout(2, 3, 10, 8));
        buttonGrid.setBackground(SIDEBAR_COLOR);
        buttonGrid.setBorder(BorderFactory.createEmptyBorder(10, 16, 10, 16));
        
        // Row 1: Image operations
        buttonGrid.add(toolbarBtn("📁 Choisir image",  ACCENT_COLOR, e -> choix_image()));
        buttonGrid.add(toolbarBtn("🔍 Détecter",       PRIMARY_COLOR, e -> detecter_panneau()));
        buttonGrid.add(toolbarBtn("🗑️  Effacer",       DANGER_COLOR, e -> clearImages()));
        
        // Row 2: Video and options
        buttonGrid.add(toolbarBtn("🎬 Vidéo",          PRIMARY_COLOR, e -> openVideoDetection()));
        buttonGrid.add(toolbarBtn("⚙️  Options",       new Color(100, 120, 160), e -> showOptionsDialog()));
        buttonGrid.add(new JPanel()); // Empty cell
        
        JPanel bottomSection = new JPanel(new BorderLayout());
        bottomSection.setBackground(SIDEBAR_COLOR);
        bottomSection.add(buttonGrid, BorderLayout.CENTER);
        
        toolbar.add(titleSection, BorderLayout.NORTH);
        toolbar.add(bottomSection, BorderLayout.CENTER);
        return toolbar;
    }
    
    private JButton toolbarBtn(String text, Color color, ActionListener action) {
        JButton btn = new JButton(text);
        btn.setFont(new Font("Segoe UI", Font.BOLD, 11));
        btn.setForeground(Color.WHITE);
        btn.setBackground(color);
        btn.setBorderPainted(false);
        btn.setFocusPainted(false);
        btn.setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));
        btn.addMouseListener(new MouseAdapter() {
            public void mouseEntered(MouseEvent e) {
                btn.setBackground(brighten(color, 30));
            }
            public void mouseExited(MouseEvent e) {
                btn.setBackground(color);
            }
        });
        btn.addActionListener(action);
        return btn;
    }
    
    private Color brighten(Color c, int amount) {
        return new Color(
            Math.min(c.getRed() + amount, 255),
            Math.min(c.getGreen() + amount, 255),
            Math.min(c.getBlue() + amount, 255)
        );
    }
    
    private void showOptionsDialog() {
        JDialog dialog = new JDialog(this, "Options", true);
        dialog.setSize(400, 280);
        dialog.setLocationRelativeTo(this);
        JPanel p = new JPanel(new BoxLayout(new JPanel(), BoxLayout.Y_AXIS));
        p.setBackground(BG_COLOR);
        p.setBorder(BorderFactory.createEmptyBorder(20, 20, 20, 20));
        p.add(sliderOption("Échelle image", 25, 100, (int)(imageScaleFactor * 100),
            val -> { imageScaleFactor = val / 100.0; if (originalImage != null) refreshMainImage(); }));
        p.add(Box.createVerticalStrut(12));
        p.add(sliderOption("Échelle détection", 25, 100, (int)(detectionScaleFactor * 100),
            val -> { detectionScaleFactor = val / 100.0; refreshDetectionImage(); }));
        p.add(Box.createVerticalStrut(16));
        p.add(checkOption("Détection auto", autoDetect, v -> autoDetect = v));
        dialog.add(new JScrollPane(p));
        dialog.setVisible(true);
    }





    private JPanel sliderOption(String label, int min, int max, int init,
                                java.util.function.IntConsumer onChange) {
        JPanel p = new JPanel();
        p.setBackground(BG_COLOR);
        p.setLayout(new BoxLayout(p, BoxLayout.Y_AXIS));
        p.setMaximumSize(new Dimension(350, 60));
        JLabel lbl = new JLabel(label + " : " + init + "%");
        lbl.setFont(new Font("Segoe UI", Font.BOLD, 12));
        lbl.setForeground(TEXT_DARK);
        lbl.setAlignmentX(Component.LEFT_ALIGNMENT);
        JSlider slider = new JSlider(min, max, init);
        slider.setBackground(BG_COLOR);
        slider.setMaximumSize(new Dimension(350, 28));
        slider.setAlignmentX(Component.LEFT_ALIGNMENT);
        slider.addChangeListener(e -> {
            lbl.setText(label + " : " + slider.getValue() + "%");
            if (!slider.getValueIsAdjusting()) onChange.accept(slider.getValue());
        });
        p.add(lbl); p.add(slider);
        return p;
    }

    private JPanel checkOption(String label, boolean init,
                               java.util.function.Consumer<Boolean> onChange) {
        JPanel p = new JPanel(new FlowLayout(FlowLayout.LEFT, 8, 4));
        p.setBackground(BG_COLOR);
        p.setMaximumSize(new Dimension(350, 30));
        JCheckBox cb = new JCheckBox(label, init);
        cb.setBackground(BG_COLOR);
        cb.setForeground(TEXT_DARK);
        cb.setFont(new Font("Segoe UI", Font.PLAIN, 12));
        cb.setFocusPainted(false);
        cb.addActionListener(e -> onChange.accept(cb.isSelected()));
        p.add(cb);
        return p;
    }

    // ══════════════════════════════════════════════════════════════════════════
    //  CONTENT
    // ══════════════════════════════════════════════════════════════════════════
    private JPanel buildContent() {
        JPanel content = new JPanel(new BorderLayout());
        content.setBackground(BG_COLOR);

        // Header removed - moved to top toolbar

        // Centre
        JPanel centre = new JPanel(new BorderLayout(0, 0));
        centre.setBackground(BG_COLOR);

        // Bandeau résultat
        resultBanner = new JLabel("", SwingConstants.CENTER);
        resultBanner.setFont(new Font("Arial", Font.BOLD, 16));
        resultBanner.setOpaque(true);
        resultBanner.setBackground(ACCENT_COLOR);
        resultBanner.setForeground(Color.WHITE);
        resultBanner.setPreferredSize(new Dimension(0, 0));
        centre.add(resultBanner, BorderLayout.NORTH);

        // Deux cartes côte à côte
        imagesPanel = new JPanel(new GridLayout(1, 2, 16, 0));
        imagesPanel.setBackground(BG_COLOR);
        imagesPanel.setBorder(BorderFactory.createEmptyBorder(14, 14, 14, 14));

        // Carte gauche : image originale
        JPanel cardOrig = new JPanel(new BorderLayout());
        cardOrig.setBackground(CARD_BG);
        cardOrig.setBorder(BorderFactory.createLineBorder(PRIMARY_COLOR, 2));
        JPanel origHeader = new JPanel(new FlowLayout(FlowLayout.LEFT, 12, 10));
        origHeader.setBackground(PRIMARY_COLOR);
        JLabel origTitle = new JLabel("■  Image originale");
        origTitle.setFont(new Font("Segoe UI", Font.BOLD, 13));
        origTitle.setForeground(Color.WHITE);
        origHeader.add(origTitle);
        cardOrig.add(origHeader, BorderLayout.NORTH);
        imageLabel = new JLabel("Aucune image", SwingConstants.CENTER);
        imageLabel.setFont(new Font("Segoe UI", Font.PLAIN, 13));
        imageLabel.setForeground(new Color(190, 195, 205));
        cardOrig.add(imageLabel, BorderLayout.CENTER);

        // Carte droite : image détectée
        JPanel cardDet = new JPanel(new BorderLayout());
        cardDet.setBackground(CARD_BG);
        cardDet.setBorder(BorderFactory.createLineBorder(ACCENT_COLOR, 2));
        JPanel detHeader = new JPanel(new FlowLayout(FlowLayout.LEFT, 12, 10));
        detHeader.setBackground(ACCENT_COLOR);
        JLabel detTitle = new JLabel("●  Résultat de la détection");
        detTitle.setFont(new Font("Segoe UI", Font.BOLD, 13));
        detTitle.setForeground(Color.WHITE);
        detHeader.add(detTitle);
        cardDet.add(detHeader, BorderLayout.NORTH);
        imageLabel2 = new JLabel("En attente de détection", SwingConstants.CENTER);
        imageLabel2.setFont(new Font("Segoe UI", Font.PLAIN, 13));
        imageLabel2.setForeground(new Color(190, 195, 205));
        cardDet.add(imageLabel2, BorderLayout.CENTER);

        imagesPanel.add(cardOrig);
